---
import { type Locale, localePath, t } from "../i18n";
import Logo from "./Logo.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale);
const repoUrl = "https://github.com/Cedric-ruiu/loopcube";
const authorUrl = "https://cedric-ruiu.fr/";
const email = "contact@cedric-ruiu.fr";
const [creditStart, creditMiddle, creditEnd] = m.footer.credit.split(/\{name\}|\{site\}/);
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__grid">
			<section class="site-footer__section site-footer__brand">
				<a class="brand" href={localePath(locale)} aria-label={m.nav.home}>
					<Logo height={40} />
				</a>
				<p>{m.footer.tagline}</p>
			</section>

			<section class="site-footer__section" aria-labelledby="footer-contact-title">
				<h2 id="footer-contact-title">{m.footer.contactTitle}</h2>
				<p>{m.footer.contactText}</p>
				<ul class="site-footer__links">
					<li class="site-footer__row">
						<a href={`mailto:${email}?subject=${encodeURIComponent(m.footer.contactSubject)}`}>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect x="3" y="5" width="18" height="14" rx="1" />
								<path d="m3 7 9 6 9-6" />
							</svg>
							<span>{m.footer.contactCta}</span>
						</a>
						<button type="button" data-footer-copy hidden>
							<!-- Both labels share one grid cell so the button keeps the width of
							     the longer one: confirming the copy never wraps the row. -->
							<span class="site-footer__swap" aria-live="polite">
								<span>{m.footer.copyEmail}</span>
								<span class="is-hidden">{m.footer.copySuccess}</span>
							</span>
						</button>
					</li>
					<li>
						<button type="button" data-footer-share hidden>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 15V3M8 7l4-4 4 4M5 12v8h14v-8" />
							</svg>
							<span class="site-footer__swap" aria-live="polite">
								<span>{m.footer.share}</span>
								<span class="is-hidden">{m.footer.shareCopied}</span>
							</span>
						</button>
					</li>
				</ul>
			</section>

			<section class="site-footer__section" aria-labelledby="footer-contribute-title">
				<h2 id="footer-contribute-title">{m.footer.contributeTitle}</h2>
				<p>{m.footer.openSource}</p>
				<ul class="site-footer__links">
					<li>
						<a href={repoUrl} target="_blank" rel="noopener noreferrer">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
							</svg>
							Cedric-ruiu/loopcube
						</a>
					</li>
					<li>
						<a href={`${repoUrl}/issues`} target="_blank" rel="noopener noreferrer">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="12" cy="12" r="9" />
								<path d="M12 8v5M12 16h.01" />
							</svg>
							{m.footer.issues}
						</a>
					</li>
				</ul>
			</section>
		</div>

		<p class="site-footer__credit">
			{creditStart}<a href={authorUrl} target="_blank" rel="author noopener">Cédric Ruiu</a>{creditMiddle}<a href={authorUrl} target="_blank" rel="noopener">cedric-ruiu.fr</a>{creditEnd}
		</p>
	</div>
</footer>

<script define:vars={{ email }}>
	const copyButton = document.querySelector("[data-footer-copy]");
	const shareButton = document.querySelector("[data-footer-share]");

	const confirm = (button) => {
		const [label, done] = button.querySelectorAll(".site-footer__swap > span");
		label.classList.add("is-hidden");
		done.classList.remove("is-hidden");
		clearTimeout(button.timer);
		button.timer = setTimeout(() => {
			label.classList.remove("is-hidden");
			done.classList.add("is-hidden");
		}, 2000);
	};

	// The mailto link does nothing without a configured mail app (common on
	// desktop with webmail), so the address can be copied.
	if (copyButton instanceof HTMLButtonElement && navigator.clipboard) {
		copyButton.hidden = false;
		copyButton.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(email);
				confirm(copyButton);
			} catch {
				// Clipboard permission denied: the address stays visible anyway.
			}
		});
	}

	// Desktop share sheets offer few relevant targets, so the native sheet is
	// kept for touch devices; desktop copies the link instead.
	const nativeShare =
		typeof navigator.share === "function" && window.matchMedia("(pointer: coarse)").matches;
	if (shareButton instanceof HTMLButtonElement && (nativeShare || navigator.clipboard)) {
		shareButton.hidden = false;
		shareButton.addEventListener("click", async () => {
			const url = document.querySelector('link[rel="canonical"]')?.href ?? window.location.href;
			try {
				if (nativeShare) {
					await navigator.share({ title: document.title, url });
				} else {
					await navigator.clipboard.writeText(url);
					confirm(shareButton);
				}
			} catch {
				// Share sheet dismissed or clipboard denied: nothing to do.
			}
		});
	}
</script>

<style>
	.site-footer__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: start;
		gap: var(--space-xl) var(--gap-columns);
	}
	.site-footer__section {
		display: grid;
		justify-items: start;
		align-content: start;
		gap: var(--space-sm);
	}
	.site-footer__section h2 {
		margin: 0;
		font: var(--display-weight) var(--text-md) / 1.2 var(--font-display);
		color: var(--color-ink);
	}
	.site-footer__section p {
		max-width: 38ch;
		margin: 0;
		color: var(--color-ink-2);
		font-size: var(--text-sm);
		line-height: 1.6;
	}
	.site-footer__links {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.site-footer__links .site-footer__row {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--space-md);
	}
	.site-footer__links a,
	.site-footer__links button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		min-height: 44px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-ink);
		font: inherit;
		font-size: var(--text-sm);
		line-height: 1.5;
		text-align: left;
		text-decoration: underline;
		text-decoration-color: var(--color-muted);
		text-underline-offset: 0.2em;
		cursor: pointer;
		transition: text-decoration-color var(--dur-short) var(--ease-out);
	}
	.site-footer__links button[hidden] {
		display: none;
	}
	.site-footer__links svg {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
	}
	.site-footer__swap {
		display: inline-grid;
		justify-items: start;
	}
	.site-footer__swap > span {
		grid-area: 1 / 1;
	}
	.site-footer__swap > .is-hidden {
		visibility: hidden;
	}
	.site-footer__credit {
		margin: var(--space-xl) 0 0;
		padding-top: var(--space-md);
		border-top: 1px solid var(--color-rule);
		color: var(--color-muted);
		font-size: var(--text-sm);
		line-height: 1.6;
	}
	.site-footer__credit a {
		color: var(--color-ink);
		font-size: inherit;
		line-height: inherit;
		text-decoration-color: var(--color-muted);
		text-underline-offset: 0.2em;
	}
	.site-footer__links a:hover,
	.site-footer__links button:hover,
	.site-footer__credit a:hover {
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 2px;
	}
	.site-footer__links a:focus-visible,
	.site-footer__links button:focus-visible,
	.site-footer__credit a:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}

	@media (max-width: 760px) {
		.site-footer__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.site-footer__brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 520px) {
		.site-footer__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
