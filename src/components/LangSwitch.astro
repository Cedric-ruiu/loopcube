---
import { type Locale, localePath, locales, t } from "../i18n";

interface Props {
	current: Locale;
}

const { current } = Astro.props;
---

<nav aria-label={t(current).langSwitch.label}>
	<ul>
		{
			locales.map((l) => (
				<li>
					<a
						href={localePath(l)}
						hreflang={l}
						lang={l}
						data-lang={l}
						aria-current={l === current ? "page" : undefined}
					>
						{t(l).langName}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	ul {
		display: flex;
		gap: var(--space-2xs);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: var(--space-sm);
		border-radius: var(--radius-input);
		font-size: var(--text-ui);
		color: var(--color-muted);
		text-decoration: none;
		transition: color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
	}
	a:hover {
		color: var(--color-ink);
		background: var(--color-paper-2);
	}
	a:active {
		background: var(--color-paper-3);
	}
	a:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}
	a[aria-current="page"] {
		color: var(--color-ink);
		font-weight: 600;
		box-shadow: inset 0 -2px 0 var(--color-accent);
		border-radius: 0;
	}
</style>
