---
import { Font } from "astro:assets";
import Analytics from "../components/Analytics.astro";
import Logo from "../components/Logo.astro";
import LogoSymbol from "../components/LogoSymbol.astro";
import { fallbackLocale, localePath, locales, t } from "../i18n";

// Served at any missing address, so no canonical, hreflang or Open Graph from Base
const title = `LoopCube — ${locales.map((l) => t(l).notFound.title).join(" · ")}`;
---

<!doctype html>
<html lang={fallbackLocale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<Font cssVariable="--font-barlow" preload />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
		<Analytics />
	</head>
	<body>
		<LogoSymbol />
		<main class="container lost">
			<h1><span class="visually-hidden">LoopCube</span><Logo height={48} /></h1>
			<div class="lost__langs">
				{
					locales.map((l) => (
						<section lang={l}>
							<h2>{t(l).notFound.title}</h2>
							<p>{t(l).notFound.text}</p>
							<a class="btn btn--quiet" href={localePath(l)} hreflang={l}>
								{t(l).notFound.link}
							</a>
						</section>
					))
				}
			</div>
		</main>
	</body>
</html>

<style is:global>
	@import url("../styles/site.css");
</style>

<style>
	.lost {
		display: grid;
		align-content: center;
		gap: var(--space-2xl);
		min-height: 100svh;
		padding-block: var(--space-2xl);
	}
	.lost__langs {
		display: grid;
		gap: var(--space-xl) var(--gap-columns);
	}
	section {
		display: grid;
		gap: var(--space-md);
		justify-items: start;
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-rule);
	}
	h2 {
		font-size: var(--text-2xl);
		text-wrap: balance;
	}
	p {
		color: var(--color-ink-2);
	}
	@media (min-width: 48rem) {
		.lost__langs {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
